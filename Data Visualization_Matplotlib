
# ==========================================
# HEALTHCARE DATA VISUALIZATION
# Using Pandas and Matplotlib
# ==========================================

import pandas as pd
import matplotlib.pyplot as plt

# 1. LOAD THE DATASET
url = "https://raw.githubusercontent.com/Marvan-IT/Healthcare-Data-Analysis/main/data/healthcare_dataset.csv"

df = pd.read_csv(url)

print("Dataset loaded successfully!")
print("Dataset shape:", df.shape)
print(df.head())


# 2. PREPARE THE DATA
df["Date of Admission"] = pd.to_datetime(
    df["Date of Admission"], errors="coerce"
)

df["Billing Amount"] = pd.to_numeric(
    df["Billing Amount"], errors="coerce"
)

df["Age"] = pd.to_numeric(df["Age"], errors="coerce")

# Remove rows with missing values in columns used for plotting
df = df.dropna(
    subset=["Date of Admission", "Age",
            "Billing Amount", "Medical Condition"]
)


# 3. CUSTOM VISUALIZATION STYLE
plt.style.use("seaborn-v0_8-whitegrid")

fig, axes = plt.subplots(1, 3, figsize=(21, 6))

fig.suptitle(
    "HEALTHCARE DATA ANALYSIS",
    fontsize=20,
    fontweight="bold"
)


# ==========================================
# 4. LINE PLOT
# Monthly Hospital Admissions
# ==========================================

monthly_admissions = (
    df.set_index("Date of Admission")
      .resample("ME")
      .size()
)

axes[0].plot(
    monthly_admissions.index,
    monthly_admissions.values,
    color="blue",
    linewidth=2,
    marker="o",
    markersize=4,
    label="Monthly Admissions"
)

axes[0].set_title(
    "Monthly Hospital Admissions",
    fontsize=13,
    fontweight="bold"
)

axes[0].set_xlabel("Admission Date")
axes[0].set_ylabel("Number of Patients")
axes[0].legend()
axes[0].tick_params(axis="x", rotation=45)


# ==========================================
# 5. SCATTER PLOT
# Age vs Hospital Billing
# ==========================================

sample = df.sample(
    n=min(5000, len(df)),
    random_state=42
)

axes[1].scatter(
    sample["Age"],
    sample["Billing Amount"],
    alpha=0.5,
    color="green",
    s=25,
    edgecolors="none"
)

axes[1].set_title(
    "Patient Age vs Billing Amount",
    fontsize=13,
    fontweight="bold"
)

axes[1].set_xlabel("Patient Age")
axes[1].set_ylabel("Billing Amount")


# ==========================================
# 6. BAR CHART
# Patients by Medical Condition
# ==========================================

condition_counts = (
    df["Medical Condition"]
    .value_counts()
    .sort_values(ascending=False)
)

axes[2].bar(
    condition_counts.index,
    condition_counts.values,
    color="orange",
    edgecolor="black",
    linewidth=0.7
)

axes[2].set_title(
    "Patients by Medical Condition",
    fontsize=13,
    fontweight="bold"
)

axes[2].set_xlabel("Medical Condition")
axes[2].set_ylabel("Number of Patients")

axes[2].tick_params(axis="x", rotation=45)


# ==========================================
# 7. CUSTOM STYLING
# ==========================================

for ax in axes:
    ax.grid(
        True,
        linestyle="--",
        alpha=0.4
    )

plt.tight_layout(rect=[0, 0, 1, 0.92])

# Save the visualization
plt.savefig(
    "healthcare_visualization.png",
    dpi=300,
    bbox_inches="tight"
)

# Display charts
plt.show()
